flowchart TB
  CRED[".credentials/<br/>google-oauth-raisd-sso.env<br/>gitignored"]
  DEPLOY["deploy-vps.sh sso"]
  SECRET["K8s Secret<br/>campus/sso-secrets"]
  DEP["Deployment sso<br/>gitops/apps/sso"]
  POD["SSO pod"]
  META["GET /v1/meta<br/>channels.google.enabled"]
  UI["Login UI<br/>Google + Passkey row"]

  CRED --> DEPLOY
  DEPLOY -->|"GOOGLE_CLIENT_ID<br/>GOOGLE_CLIENT_SECRET<br/>GOOGLE_REDIRECT_URI"| SECRET
  SECRET --> DEP
  DEP -->|"secretKeyRef optional"| POD
  POD --> META
  META -->|"enabled true"| UI
  POD -->|"start + callback"| GOOGLE[Google OAuth]

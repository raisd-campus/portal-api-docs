flowchart LR
  U[User] --> P[Portal / landing]
  P -->|"returnUrl"| LOGIN[SSO /login]
  LOGIN --> START["Google start<br/>channel enabled?"]
  START --> AUTH["Google authorize<br/>openid email profile"]
  AUTH --> PICK[Account picker]
  PICK --> CB["SSO callback<br/>code + state"]
  CB --> TOKEN[Token exchange]
  TOKEN --> INFO[userinfo<br/>email + sub]
  INFO --> MATCH{Invited person<br/>with roles?}
  MATCH -->|no| DENY["/login?googleError"]
  MATCH -->|yes| CONT[redirectAfterLogin]
  CONT --> DONE["returnUrl?code=<br/>or role picker"]

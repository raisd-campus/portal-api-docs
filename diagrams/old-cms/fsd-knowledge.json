    {
      "id": "cms",
      "label": "Cyberjaya CMS",
      "group": "root",
      "val": 28,
      "summary": "Multi-app PHPMaker (+ Laravel) campus CMS sharing MySQL cmscbj. Each desk is a separate web app with its own login, menu, and permissions.",
      "tables": ["cmscbj (shared MySQL)", "cyberjaya/campus/<desk>/"],
      "menus": ["~20 staff modules under campus/"],
      "raisd": "Keep as SoR (ADR-1). Portals talk only via Portal API / CAP-53 ACL.",
      "href": "./fsd.html"
    },
    {
      "id": "grp-academic",
